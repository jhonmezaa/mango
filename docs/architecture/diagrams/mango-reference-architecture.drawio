        <mxCell id="ma-plan" value="PREVISTO, SIN CONSTRUIR" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;dashed=1;strokeColor=#879196;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#545B64;fontSize=12;fontStyle=1;dashPattern=4 4;strokeWidth=2;" vertex="1" parent="ma-1"><mxGeometry x="20" y="1050" width="1960" height="120" as="geometry"/></mxCell>
        <mxCell id="ma-pl0" value="&lt;b&gt;Previsto&lt;/b&gt;&lt;br&gt;Mango-&amp;lt;ns&amp;gt;-Operator en las cuentas miembro: desactivado por defecto, solo tras aprobación, por dominio y con permission boundary (D51 (5))" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;dashed=1;dashPattern=4 4;strokeColor=#879196;fillColor=#F8F9FA;fontColor=#545B64;arcSize=12;spacing=8;" vertex="1" parent="ma-plan"><mxGeometry x="20" y="34" width="470" height="70" as="geometry"/></mxCell>
        <mxCell id="ma-pl1" value="&lt;b&gt;Previsto&lt;/b&gt;&lt;br&gt;Stack Mango-&amp;lt;ns&amp;gt;-Support en la cuenta de IAM Identity Center: permission sets de soporte sin assignment (D7, pendiente)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;dashed=1;dashPattern=4 4;strokeColor=#879196;fillColor=#F8F9FA;fontColor=#545B64;arcSize=12;spacing=8;" vertex="1" parent="ma-plan"><mxGeometry x="502" y="34" width="470" height="70" as="geometry"/></mxCell>
        <mxCell id="ma-pl2" value="&lt;b&gt;Previsto&lt;/b&gt;&lt;br&gt;Data Export CUR 2.0 legible desde la cuenta mango, para no depender de la pagadora en cada pregunta" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;dashed=1;dashPattern=4 4;strokeColor=#879196;fillColor=#F8F9FA;fontColor=#545B64;arcSize=12;spacing=8;" vertex="1" parent="ma-plan"><mxGeometry x="984" y="34" width="470" height="70" as="geometry"/></mxCell>
        <mxCell id="ma-pl3" value="&lt;b&gt;Previsto&lt;/b&gt;&lt;br&gt;Leer el estado de las instancias del StackSet en la comprobación de conectividad" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;dashed=1;dashPattern=4 4;strokeColor=#879196;fillColor=#F8F9FA;fontColor=#545B64;arcSize=12;spacing=8;" vertex="1" parent="ma-plan"><mxGeometry x="1466" y="34" width="470" height="70" as="geometry"/></mxCell>
        <mxCell id="ma-legend" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Línea gris: llamada dentro de la cuenta mango (sts:AssumeRole al broker; discontinua = escritura) · Línea magenta: AssumeRole entre cuentas (continua = lectura; discontinua = escritura, solo con un approval token válido) · Línea rosa discontinua: despliegue del StackSet&lt;br&gt;Orden de instalación: Payer → OrgAccess → PackNetwork → Core. Entre cuentas, ningún stack lee a otro: nombres deterministas Mango-&amp;lt;ns&amp;gt;-… En la cuenta mango, Core importa de PackNetwork las subnets y los security groups de los packs. No se crean OUs ni SCPs.&lt;br&gt;Los packs de datos de cuentas solo los usan los usuarios centrales (Cedar L2, D49). Fuente: docs/architecture/reference-architecture.md §4.10." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeColor=#879196;fillColor=#F8F9FA;fontColor=#232F3E;" vertex="1" parent="ma-1"><mxGeometry x="20" y="1200" width="1960" height="100" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
