        <mxCell id="ma-gw" value="AgentCore Gateway&lt;br&gt;interceptor + Policy" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;labelBackgroundColor=#FFFFFF;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock_agentcore;" vertex="1" parent="ma-acc"><mxGeometry x="40" y="344" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="ma-ap" value="AdminProbe (Lambda)&lt;br&gt;comprobación de conectividad;&lt;br&gt;la invoca mango-api" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;labelBackgroundColor=#FFFFFF;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="ma-acc"><mxGeometry x="240" y="91" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="ma-pk" value="Runtimes de packs de datos de cuentas&lt;br&gt;aws-cloudwatch → ReadBroker&lt;br&gt;aws-billing → BillingBroker&lt;br&gt;(en la red de Mango-&amp;lt;ns&amp;gt;-PackNetwork)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;labelBackgroundColor=#FFFFFF;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock_agentcore;" vertex="1" parent="ma-acc"><mxGeometry x="240" y="224" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="ma-ce" value="Conector Cost Explorer (Lambda)&lt;br&gt;impone las cuentas del área&lt;br&gt;de quien pregunta (D35)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;labelBackgroundColor=#FFFFFF;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="ma-acc"><mxGeometry x="240" y="394" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="ma-ae" value="Approval executor (Lambda)&lt;br&gt;valida el approval token&lt;br&gt;(KMS, un solo uso)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;labelBackgroundColor=#FFFFFF;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="ma-acc"><mxGeometry x="240" y="530" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="ma-gbro" value="Brokers por privilegio" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;dashed=1;strokeColor=#879196;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#545B64;fontSize=12;fontStyle=1;" vertex="1" parent="ma-acc"><mxGeometry x="500" y="34" width="210" height="700" as="geometry"/></mxCell>
        <mxCell id="ma-rb" value="Mango-&amp;lt;ns&amp;gt;-ReadBroker" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;labelBackgroundColor=#FFFFFF;shape=mxgraph.aws4.role;" vertex="1" parent="ma-gbro"><mxGeometry x="73" y="72" width="64" height="36" as="geometry"/></mxCell>
        <mxCell id="ma-bb" value="Mango-&amp;lt;ns&amp;gt;-BillingBroker" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;labelBackgroundColor=#FFFFFF;shape=mxgraph.aws4.role;" vertex="1" parent="ma-gbro"><mxGeometry x="73" y="312" width="64" height="36" as="geometry"/></mxCell>
        <mxCell id="ma-ob" value="Mango-&amp;lt;ns&amp;gt;-OperateBroker" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;labelBackgroundColor=#FFFFFF;shape=mxgraph.aws4.role;" vertex="1" parent="ma-gbro"><mxGeometry x="73" y="502" width="64" height="36" as="geometry"/></mxCell>
        <mxCell id="ma-bronote" value="• El trust de cada broker lista los ARN exactos de quienes pueden usarlo, en una condición (sin ABAC con :root), y exige SourceIdentity.&lt;br&gt;• Añadir o quitar conectores o packs no obliga a redesplegar el StackSet.&lt;br&gt;• Solo el approval executor puede asumir OperateBroker.&lt;br&gt;• Role chaining ⇒ sesión máx. 1 h." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;strokeColor=#B7A300;fillColor=#FFF9DB;fontColor=#232F3E;" vertex="1" parent="ma-acc"><mxGeometry x="20" y="644" width="450" height="100" as="geometry"/></mxCell>
        <mxCell id="ma-trust" value='&lt;b&gt;Trust de los roles de las otras cuentas (ReadOnly / BillingReader / BudgetsOperator)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Principal: &lt;font face="Courier New"&gt;arn:aws:iam::&amp;lt;MANGO&amp;gt;:root&lt;/font&gt; (AccountPrincipal)&lt;br&gt;Condition:&lt;br&gt;&amp;nbsp;&amp;nbsp;• &lt;font face="Courier New"&gt;aws:PrincipalArn&lt;/font&gt; = broker correspondiente&lt;br&gt;&amp;nbsp;&amp;nbsp;• &lt;font face="Courier New"&gt;aws:PrincipalOrgID&lt;/font&gt; = organización del cliente&lt;br&gt;&amp;nbsp;&amp;nbsp;• &lt;font face="Courier New"&gt;sts:SetSourceIdentity&lt;/font&gt; con SourceIdentity &lt;b&gt;obligatorio&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• &lt;font face="Courier New"&gt;sts:TagSession&lt;/font&gt; (mango_user, mango_agent, mango_bu; en una escritura, mango_approval)&lt;br&gt;&lt;br&gt;Así el rol existe antes que el broker y sobrevive a recreaciones.&lt;br&gt;El CloudTrail de cada cuenta destino muestra la persona y el agente (comprobado en un laboratorio: D51 (6), D55).&lt;br&gt;En cada AssumeRole, el broker añade una session policy con la acción, el recurso y la cuenta de esa llamada.&lt;br&gt;ExternalId solo para terceros, no dentro de la organización.' style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;strokeColor=#B7A300;fillColor=#FFF9DB;fontColor=#232F3E;" vertex="1" parent="ma-org"><mxGeometry x="820" y="46" width="540" height="216" as="geometry"/></mxCell>
        <mxCell id="ma-mgmt" value="Management / pagadora · stack Mango-&amp;lt;ns&amp;gt;-Payer (obligatorio hoy)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="ma-org"><mxGeometry x="820" y="312" width="540" height="400" as="geometry"/></mxCell>
        <mxCell id="ma-bill" value="Mango-&amp;lt;ns&amp;gt;-BillingReader&lt;br&gt;37 acciones exactas de lectura (D52)&lt;br&gt;y listados de Organizations" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;labelBackgroundColor=#FFFFFF;shape=mxgraph.aws4.role;" vertex="1" parent="ma-mgmt"><mxGeometry x="60" y="80" width="64" height="36" as="geometry"/></mxCell>
        <mxCell id="ma-bo" value="Mango-&amp;lt;ns&amp;gt;-BudgetsOperator&lt;br&gt;budgets:ModifyBudget, solo sobre&lt;br&gt;presupuestos Mango-&amp;lt;ns&amp;gt;-* (D56)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;labelBackgroundColor=#FFFFFF;shape=mxgraph.aws4.role;" vertex="1" parent="ma-mgmt"><mxGeometry x="60" y="270" width="64" height="36" as="geometry"/></mxCell>
        <mxCell id="ma-pay" value="Mango-&amp;lt;ns&amp;gt;-Payer&lt;br&gt;primer paso de&lt;br&gt;la instalación" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;labelBackgroundColor=#FFFFFF;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudformation;" vertex="1" parent="ma-mgmt"><mxGeometry x="290" y="74" width="48" height="48" as="geometry"/></mxCell>
