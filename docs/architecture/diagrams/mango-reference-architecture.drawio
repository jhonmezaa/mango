        <mxCell id="ru-api" value="mango-api (ECS Fargate)&lt;br&gt;despliegue rodante: 2 tareas nuevas;&lt;br&gt;las anteriores conservan 120 s&lt;br&gt;sus peticiones abiertas (D70)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;labelBackgroundColor=#FFFFFF;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="ru-gres"><mxGeometry x="90" y="50" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="ru-lam" value="Lambdas, web y packs:&lt;br&gt;solo los que cambiaron" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;labelBackgroundColor=#FFFFFF;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="ru-gres"><mxGeometry x="340" y="50" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="ru-ddb" value="Datos: RETAIN,&lt;br&gt;deletionProtection y PITR" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;labelBackgroundColor=#FFFFFF;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="ru-gres"><mxGeometry x="540" y="50" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="ru-nocb" value="✗ Sin CodeBuild · sin cdk deploy · sin bootstrap de CDK en la cuenta del cliente" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;dashed=1;strokeColor=#DD344C;fillColor=#FFF0F1;fontColor=#DD344C;" vertex="1" parent="ru-acc"><mxGeometry x="440" y="264" width="660" height="50" as="geometry"/></mxCell>
        <mxCell id="ru-ver" value="&lt;b&gt;deployment/verify-release.py&lt;/b&gt;&lt;br&gt;comprueba que el manifiesto está firmado con la llave del proveedor (packs/signing-key.pub) y que cada plantilla tiene el sha256 que el manifiesto nombra. Si responde NOT VERIFIED, no se instala." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#D86613;fillColor=#FFFFFF;fontColor=#232F3E;arcSize=12;" vertex="1" parent="ru-acc"><mxGeometry x="100" y="334" width="340" height="90" as="geometry"/></mxCell>
        <mxCell id="ru-adm" value="Administrador del cliente&lt;br&gt;instala y actualiza desde la consola o la CLI (D58 (2))" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;labelBackgroundColor=#FFFFFF;shape=mxgraph.aws4.users;" vertex="1" parent="ru-1"><mxGeometry x="832" y="930" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="ru-plan" value="PREVISTO, SIN CONSTRUIR" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;dashed=1;strokeColor=#879196;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#545B64;fontSize=12;fontStyle=1;dashPattern=4 4;strokeWidth=2;" vertex="1" parent="ru-1"><mxGeometry x="20" y="1060" width="1940" height="110" as="geometry"/></mxCell>
        <mxCell id="ru-pl0" value="&lt;b&gt;Previsto&lt;/b&gt;&lt;br&gt;Migraciones de datos con un recurso personalizado idempotente" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;dashed=1;dashPattern=4 4;strokeColor=#879196;fillColor=#F8F9FA;fontColor=#545B64;arcSize=12;spacing=8;" vertex="1" parent="ru-plan"><mxGeometry x="20" y="34" width="306" height="60" as="geometry"/></mxCell>
        <mxCell id="ru-pl1" value="&lt;b&gt;Previsto&lt;/b&gt;&lt;br&gt;Modo mantenimiento y validación de versión y esquema entre stacks" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;dashed=1;dashPattern=4 4;strokeColor=#879196;fillColor=#F8F9FA;fontColor=#545B64;arcSize=12;spacing=8;" vertex="1" parent="ru-plan"><mxGeometry x="338" y="34" width="306" height="60" as="geometry"/></mxCell>
        <mxCell id="ru-pl2" value="&lt;b&gt;Previsto&lt;/b&gt;&lt;br&gt;Actualización por el equipo de Mango vía IAM Identity Center (Mango-&amp;lt;ns&amp;gt;-Support, D7)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;dashed=1;dashPattern=4 4;strokeColor=#879196;fillColor=#F8F9FA;fontColor=#545B64;arcSize=12;spacing=8;" vertex="1" parent="ru-plan"><mxGeometry x="656" y="34" width="306" height="60" as="geometry"/></mxCell>
        <mxCell id="ru-pl3" value="&lt;b&gt;Previsto&lt;/b&gt;&lt;br&gt;Botón de actualizar en la consola de administración" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;dashed=1;dashPattern=4 4;strokeColor=#879196;fillColor=#F8F9FA;fontColor=#545B64;arcSize=12;spacing=8;" vertex="1" parent="ru-plan"><mxGeometry x="974" y="34" width="306" height="60" as="geometry"/></mxCell>
        <mxCell id="ru-pl4" value="&lt;b&gt;Previsto&lt;/b&gt;&lt;br&gt;Imagen en un ECR del cliente (privateEcrRepo); runtimes de agentes code-defined" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;dashed=1;dashPattern=4 4;strokeColor=#879196;fillColor=#F8F9FA;fontColor=#545B64;arcSize=12;spacing=8;" vertex="1" parent="ru-plan"><mxGeometry x="1292" y="34" width="306" height="60" as="geometry"/></mxCell>
        <mxCell id="ru-pl5" value="&lt;b&gt;Previsto&lt;/b&gt;&lt;br&gt;Terraform envoltorio, Service Catalog y AWS Marketplace" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;dashed=1;dashPattern=4 4;strokeColor=#879196;fillColor=#F8F9FA;fontColor=#545B64;arcSize=12;spacing=8;" vertex="1" parent="ru-plan"><mxGeometry x="1610" y="34" width="306" height="60" as="geometry"/></mxCell>
        <mxCell id="ru-legend" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;①–⑥: secuencia de una release · ① a ③ en GitHub Actions y la cuenta del proveedor (que no se instala en el cliente), una vez por release · ④ a ⑥ en la organización del cliente, ejecutado por el cliente&lt;br&gt;Línea discontinua: CloudFormation y ECS descargan artefactos ya construidos (plantillas, assets e imagen por digest); en la cuenta del cliente no se compila nada · Caja gris punteada: &lt;b&gt;previsto&lt;/b&gt;&lt;br&gt;Orden al instalar: Payer → OrgAccess → PackNetwork → Core. Al actualizar, PackNetwork va antes que Core cuando la versión añade un pack o cambia su red, y después cuando lo quita. Ninguna descripción de stack nombra la release (D69 (4)).&lt;br&gt;El CI de cada pull request (cdk-nag, cfn-guard, Checkov, tests) solo verifica: nunca despliega. Personalizaciones solo por parámetros de stack o configuración de la app. Fuente: docs/architecture/reference-architecture.md §4.8, §4.9 y §4.12." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeColor=#879196;fillColor=#F8F9FA;fontColor=#232F3E;" vertex="1" parent="ru-1"><mxGeometry x="20" y="1200" width="1940" height="104" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
