        <mxCell id="ru-title" value="Release y actualización · plantillas pre-sintetizadas y firmadas, sin CodeBuild en el cliente (lo construido al 2026-10-06)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="ru-1"><mxGeometry x="20" y="2" width="1800" height="34" as="geometry"/></mxCell>
