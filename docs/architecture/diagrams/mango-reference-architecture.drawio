        <mxCell id="ma-cloud" value="AWS Cloud" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="ma-1"><mxGeometry x="20" y="50" width="1900" height="1110" as="geometry"/></mxCell>
        <mxCell id="ma-org" value="AWS Organization del cliente · Control Tower" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;dashed=1;strokeColor=#E7157B;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#E7157B;fontSize=12;fontStyle=1;dashPattern=8 4;strokeWidth=2;" vertex="1" parent="ma-cloud"><mxGeometry x="20" y="30" width="1860" height="1060" as="geometry"/></mxCell>
        <mxCell id="ma-acc" value="Cuenta mango · Mango-&amp;lt;ns&amp;gt;-Core" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="ma-org"><mxGeometry x="20" y="46" width="580" height="640" as="geometry"/></mxCell>
        <mxCell id="ma-gw" value="AgentCore Gateway + Policy&lt;br&gt;¿usuario → cuenta permitida?" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;labelBackgroundColor=#FFFFFF;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock_agentcore;" vertex="1" parent="ma-acc"><mxGeometry x="50" y="64" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="ma-con" value="Roles de ejecución&lt;br&gt;de conectores&lt;br&gt;(Lambda / MCP en Runtime)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;labelBackgroundColor=#FFFFFF;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="ma-acc"><mxGeometry x="50" y="294" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="ma-gbro" value="Brokers por privilegio" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;dashed=1;strokeColor=#879196;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#545B64;fontSize=12;fontStyle=1;" vertex="1" parent="ma-acc"><mxGeometry x="340" y="34" width="220" height="580" as="geometry"/></mxCell>
        <mxCell id="ma-rb" value="Mango-&amp;lt;ns&amp;gt;-ReadBroker" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;labelBackgroundColor=#FFFFFF;shape=mxgraph.aws4.role;" vertex="1" parent="ma-gbro"><mxGeometry x="78" y="40" width="64" height="36" as="geometry"/></mxCell>
        <mxCell id="ma-bb" value="Mango-&amp;lt;ns&amp;gt;-BillingBroker" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;labelBackgroundColor=#FFFFFF;shape=mxgraph.aws4.role;" vertex="1" parent="ma-gbro"><mxGeometry x="78" y="310" width="64" height="36" as="geometry"/></mxCell>
        <mxCell id="ma-ob" value="Mango-&amp;lt;ns&amp;gt;-OperateBroker" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;labelBackgroundColor=#FFFFFF;shape=mxgraph.aws4.role;" vertex="1" parent="ma-gbro"><mxGeometry x="78" y="452" width="64" height="36" as="geometry"/></mxCell>
        <mxCell id="ma-bronote" value="• El trust de cada broker lista ARNs explícitos de conectores (sin ABAC con :root).&lt;br&gt;• Añadir o quitar conectores no obliga a redesplegar el StackSet.&lt;br&gt;• ReadOnly no permite llegar a Operator.&lt;br&gt;• Role chaining ⇒ sesión máx. 1 h." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;strokeColor=#B7A300;fillColor=#FFF9DB;fontColor=#232F3E;" vertex="1" parent="ma-acc"><mxGeometry x="20" y="519" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="ma-trust" value='&lt;b&gt;Trust de los roles spoke (ReadOnly / Operator / BillingReader)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Principal: &lt;font face="monospace"&gt;arn:aws:iam::&amp;lt;MANGO&amp;gt;:root&lt;/font&gt; (AccountPrincipal)&lt;br&gt;Condition:&lt;br&gt;&amp;nbsp;&amp;nbsp;• &lt;font face="monospace"&gt;aws:PrincipalArn&lt;/font&gt; = broker correspondiente&lt;br&gt;&amp;nbsp;&amp;nbsp;• &lt;font face="monospace"&gt;aws:PrincipalOrgID&lt;/font&gt; = organización del cliente&lt;br&gt;&amp;nbsp;&amp;nbsp;• &lt;font face="monospace"&gt;sts:SetSourceIdentity&lt;/font&gt; con SourceIdentity &lt;b&gt;obligatorio&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• &lt;font face="monospace"&gt;sts:TagSession&lt;/font&gt; (mango_user, agent_id, business_unit)&lt;br&gt;&lt;br&gt;Así el spoke existe antes que el broker y sobrevive a recreaciones.&lt;br&gt;El CloudTrail de cada cuenta destino muestra la persona y el agente.&lt;br&gt;ExternalId solo para terceros, no dentro de la organización.' style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;strokeColor=#B7A300;fillColor=#FFF9DB;fontColor=#232F3E;" vertex="1" parent="ma-org"><mxGeometry x="660" y="60" width="540" height="250" as="geometry"/></mxCell>
        <mxCell id="ma-mgmt" value="Management / payer · Mango-&amp;lt;ns&amp;gt;-Payer (opcional)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="ma-org"><mxGeometry x="660" y="340" width="540" height="190" as="geometry"/></mxCell>
