        <mxCell id="rf-b6" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D86613;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="rf-1"><mxGeometry x="18" y="790" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="rf-note6" value="&lt;b&gt;⑥&lt;/b&gt; &lt;b&gt;Gateway&lt;/b&gt;: JWT de Cognito + Policy L2 (Cedar, default-deny): ¿este tipo de usuario puede llamar a esta tool?" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;strokeColor=#B7A300;fillColor=#FFF9DB;fontColor=#232F3E;" vertex="1" parent="rf-1"><mxGeometry x="1264" y="782" width="330" height="40" as="geometry"/></mxCell>
        <mxCell id="rf-b7" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D86613;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="rf-1"><mxGeometry x="18" y="858" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="rf-b8" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D86613;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="rf-1"><mxGeometry x="18" y="938" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="rf-b9" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D86613;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="rf-1"><mxGeometry x="18" y="998" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="rf-b10" value="10" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D86613;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="rf-1"><mxGeometry x="18" y="1134" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="rf-b11" value="11" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D86613;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="rf-1"><mxGeometry x="18" y="1284" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="rf-note11" value="&lt;b&gt;Final desconocido (D73)&lt;/b&gt;: se cobra lo ya sumado y el resto queda &lt;b&gt;retenido&lt;/b&gt;. «No sé cuánto costó» nunca se anota como «costó cero»." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;strokeColor=#B7A300;fillColor=#FFF9DB;fontColor=#232F3E;" vertex="1" parent="rf-1"><mxGeometry x="838" y="1310" width="330" height="44" as="geometry"/></mxCell>
        <mxCell id="rf-b12" value="12" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D86613;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="rf-1"><mxGeometry x="18" y="1434" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="rf-plan" value="PREVISTO, SIN CONSTRUIR (no forma parte del flujo de hoy)" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;dashed=1;strokeColor=#879196;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#545B64;fontSize=12;fontStyle=1;dashPattern=4 4;strokeWidth=2;" vertex="1" parent="rf-1"><mxGeometry x="20" y="1530" width="2080" height="130" as="geometry"/></mxCell>
        <mxCell id="rf-pl0" value="&lt;b&gt;Previsto&lt;/b&gt;&lt;br&gt;Ingreso por SSO con el IdP del cliente" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;dashed=1;dashPattern=4 4;strokeColor=#879196;fillColor=#F8F9FA;fontColor=#545B64;arcSize=12;spacing=8;" vertex="1" parent="rf-plan"><mxGeometry x="20" y="38" width="280" height="76" as="geometry"/></mxCell>
        <mxCell id="rf-pl1" value="&lt;b&gt;Previsto&lt;/b&gt;&lt;br&gt;Router «Asistente Mango»: hoy la persona elige el agente" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;dashed=1;dashPattern=4 4;strokeColor=#879196;fillColor=#F8F9FA;fontColor=#545B64;arcSize=12;spacing=8;" vertex="1" parent="rf-plan"><mxGeometry x="312" y="38" width="280" height="76" as="geometry"/></mxCell>
        <mxCell id="rf-pl2" value="&lt;b&gt;Previsto&lt;/b&gt;&lt;br&gt;TPM por jwt.sub en el Gateway" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;dashed=1;dashPattern=4 4;strokeColor=#879196;fillColor=#F8F9FA;fontColor=#545B64;arcSize=12;spacing=8;" vertex="1" parent="rf-plan"><mxGeometry x="604" y="38" width="280" height="76" as="geometry"/></mxCell>
        <mxCell id="rf-pl3" value="&lt;b&gt;Previsto&lt;/b&gt;&lt;br&gt;Identidad OBO / 3LO (AgentCore Identity) hacia sistemas externos" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;dashed=1;dashPattern=4 4;strokeColor=#879196;fillColor=#F8F9FA;fontColor=#545B64;arcSize=12;spacing=8;" vertex="1" parent="rf-plan"><mxGeometry x="896" y="38" width="280" height="76" as="geometry"/></mxCell>
        <mxCell id="rf-pl4" value="&lt;b&gt;Previsto&lt;/b&gt;&lt;br&gt;ApplyGuardrail sobre las salidas de tools y RAG" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;dashed=1;dashPattern=4 4;strokeColor=#879196;fillColor=#F8F9FA;fontColor=#545B64;arcSize=12;spacing=8;" vertex="1" parent="rf-plan"><mxGeometry x="1188" y="38" width="280" height="76" as="geometry"/></mxCell>
        <mxCell id="rf-pl5" value="&lt;b&gt;Previsto&lt;/b&gt;&lt;br&gt;Auditoría encadenada y digest diario firmado" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;dashed=1;dashPattern=4 4;strokeColor=#879196;fillColor=#F8F9FA;fontColor=#545B64;arcSize=12;spacing=8;" vertex="1" parent="rf-plan"><mxGeometry x="1480" y="38" width="280" height="76" as="geometry"/></mxCell>
        <mxCell id="rf-pl6" value="&lt;b&gt;Previsto&lt;/b&gt;&lt;br&gt;Reconciliación del gasto contra CUR 2.0" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;dashed=1;dashPattern=4 4;strokeColor=#879196;fillColor=#F8F9FA;fontColor=#545B64;arcSize=12;spacing=8;" vertex="1" parent="rf-plan"><mxGeometry x="1772" y="38" width="280" height="76" as="geometry"/></mxCell>
        <mxCell id="rf-legend" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Círculos naranjas ①–⑫: puntos de control en orden · Flecha continua: llamada · Flecha discontinua: respuesta o evento asíncrono · Nota amarilla: verificación interna del componente · Caja gris punteada: &lt;b&gt;previsto&lt;/b&gt;&lt;br&gt;Gobernanza preventiva: authN, RBAC L1 y la reserva de presupuesto ocurren &lt;b&gt;antes&lt;/b&gt; de invocar el modelo o una tool; la liquidación y la conciliación con las trazas solo reconcilian.&lt;br&gt;POST /api/chat no tiene límite de tasa propio: lo acota el presupuesto. Aprobar una escritura no ejecuta nada: no existe una identidad de servicio que escriba (D56). Fuente: docs/architecture/reference-architecture.md §4.3 y §4.5." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeColor=#879196;fillColor=#F8F9FA;fontColor=#232F3E;" vertex="1" parent="rf-1"><mxGeometry x="20" y="1690" width="2080" height="100" as="geometry"/></mxCell>
        <mxCell id="rf-m1" value="ingreso propio: SRP + TOTP, MFA obligatorio (D20)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#232F3E;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="200" as="sourcePoint"/><mxPoint x="404" y="200" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-m2" value="access token de 60 min: mango_role, mango_business_unit, mango_central" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;strokeColor=#545B64;fontSize=10;fontColor=#545B64;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="404" y="236" as="sourcePoint"/><mxPoint x="120" y="236" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-m2b" value="cookie de sesión HttpOnly, 8 h como máximo (D63)" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;strokeColor=#545B64;fontSize=10;fontColor=#545B64;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="546" y="272" as="sourcePoint"/><mxPoint x="120" y="272" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-m3" value="POST /api/chat · Bearer access token" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#232F3E;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="330" as="sourcePoint"/><mxPoint x="262" y="330" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-m4" value="WAF (límites por IP, D72) → ALB interno → mango-api" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#232F3E;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="262" y="362" as="sourcePoint"/><mxPoint x="546" y="362" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-m5" value="&lt;b&gt;②&lt;/b&gt; &lt;b&gt;RBAC L1&lt;/b&gt;: IsAuthorized(UseAgent) · Cedar, con los grupos y personas del agente (D33)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#232F3E;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="546" y="480" as="sourcePoint"/><mxPoint x="688" y="480" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-m6" value="ALLOW / DENY (deny por defecto)" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;strokeColor=#545B64;fontSize=10;fontColor=#545B64;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="688" y="510" as="sourcePoint"/><mxPoint x="546" y="510" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-m7" value="&lt;b&gt;③&lt;/b&gt; &lt;b&gt;reserva&lt;/b&gt;: TransactWriteItems con el peor caso del turno + fila del turno pendiente (D73)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#232F3E;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="546" y="560" as="sourcePoint"/><mxPoint x="830" y="560" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-m8" value="si no cabe: 402, sin invocar nada" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;strokeColor=#545B64;fontSize=10;fontColor=#545B64;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="590" as="sourcePoint"/><mxPoint x="546" y="590" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-m9" value="&lt;b&gt;④&lt;/b&gt; &lt;b&gt;invoca al agente&lt;/b&gt;: InvokeHarness con la sesión calculada en el servidor, el token del usuario y la firma X-Mango-Invocation" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#232F3E;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="546" y="650" as="sourcePoint"/><mxPoint x="1114" y="650" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-m10" value="&lt;b&gt;⑤&lt;/b&gt; &lt;b&gt;modelo&lt;/b&gt;: InvokeModel con el guardrail base compartido, síncrono (D34)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#232F3E;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="1114" y="710" as="sourcePoint"/><mxPoint x="972" y="710" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-m11" value="tools/call" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#232F3E;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="1114" y="770" as="sourcePoint"/><mxPoint x="1256" y="770" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-m12" value="&lt;b&gt;⑦&lt;/b&gt; &lt;b&gt;interceptor&lt;/b&gt;: firma de la invocación, tools del agente y, en una escritura, approval token" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#232F3E;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="1256" y="870" as="sourcePoint"/><mxPoint x="1398" y="870" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-m13" value="permite o rechaza" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;strokeColor=#545B64;fontSize=10;fontColor=#545B64;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="1398" y="900" as="sourcePoint"/><mxPoint x="1256" y="900" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-m14" value="&lt;b&gt;⑧&lt;/b&gt; &lt;b&gt;target&lt;/b&gt;: conector (Lambda), pack (Runtime) o approval executor" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#232F3E;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="1256" y="950" as="sourcePoint"/><mxPoint x="1540" y="950" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-m15" value="&lt;b&gt;⑨&lt;/b&gt; &lt;b&gt;identidad&lt;/b&gt;: AssumeRole por el broker + SourceIdentity, session tags y session policy (L3: IAM)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#232F3E;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="1540" y="1010" as="sourcePoint"/><mxPoint x="1682" y="1010" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-m16" value="resultado de la tool (contenido no confiable)" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;strokeColor=#545B64;fontSize=10;fontColor=#545B64;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="1540" y="1046" as="sourcePoint"/><mxPoint x="1114" y="1046" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-m17" value="escritura: mango-api calcula el tramo; tarjeta en el chat (autoconfirmación) o solicitud a un aprobador (AVP ApproveToolCall)" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;strokeColor=#545B64;fontSize=10;fontColor=#545B64;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="546" y="1106" as="sourcePoint"/><mxPoint x="120" y="1106" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-m18" value="&lt;b&gt;⑩&lt;/b&gt; &lt;b&gt;escritura aprobada&lt;/b&gt;: quien la pidió la ejecuta con su sesión; approval token (KMS, un solo uso, ligado a hash(tool, args))" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#232F3E;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="546" y="1146" as="sourcePoint"/><mxPoint x="1256" y="1146" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-m19" value="eventos del turno + uso" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;strokeColor=#545B64;fontSize=10;fontColor=#545B64;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="1114" y="1206" as="sourcePoint"/><mxPoint x="546" y="1206" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-m20" value="SSE con eventos propios: texto, fase del turno, aprobación y error (D57)" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;strokeColor=#545B64;fontSize=10;fontColor=#545B64;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="546" y="1240" as="sourcePoint"/><mxPoint x="120" y="1240" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-m21" value="&lt;b&gt;⑪&lt;/b&gt; &lt;b&gt;final conocido&lt;/b&gt;: cobra el uso real, libera el resto y borra el turno pendiente" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#232F3E;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="546" y="1296" as="sourcePoint"/><mxPoint x="830" y="1296" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-m22" value="&lt;b&gt;conciliación&lt;/b&gt; cada 5 min: cobra lo real según las trazas de AgentCore o, sin traza 15 min después del límite del turno, la reserva entera" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;strokeColor=#545B64;fontSize=10;fontColor=#545B64;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="1966" y="1396" as="sourcePoint"/><mxPoint x="830" y="1396" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-m23" value="&lt;b&gt;⑫&lt;/b&gt; &lt;b&gt;audit&lt;/b&gt;: AuditEvent con el SHA-256 de su contenido (hash por evento, sin cadena)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#232F3E;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="546" y="1446" as="sourcePoint"/><mxPoint x="1824" y="1446" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-m24" value="también el conciliador y los provisioners" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;strokeColor=#545B64;fontSize=10;fontColor=#545B64;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="1966" y="1480" as="sourcePoint"/><mxPoint x="1824" y="1480" as="targetPoint"/></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
