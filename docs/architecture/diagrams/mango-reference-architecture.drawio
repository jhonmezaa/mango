        <mxCell id="rf-m20" value="SSE / AG-UI (APPROVAL_REQUIRED, BUDGET_WARNING, POLICY_DENIED…)" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;strokeColor=#545B64;fontSize=10;fontColor=#545B64;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="546" y="1204" as="sourcePoint"/><mxPoint x="120" y="1204" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-m21" value="&lt;b&gt;⑫&lt;/b&gt; &lt;b&gt;liquidación de budget&lt;/b&gt; con el usage real (libera la reserva)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#232F3E;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="546" y="1260" as="sourcePoint"/><mxPoint x="830" y="1260" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-b12" value="12" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D86613;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="rf-1"><mxGeometry x="18" y="1248" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="rf-m22" value="&lt;b&gt;⑬&lt;/b&gt; &lt;b&gt;audit&lt;/b&gt;: AuditEvent + UsageEvent (hash-encadenado, trace_id)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#232F3E;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="546" y="1320" as="sourcePoint"/><mxPoint x="1824" y="1320" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-b13" value="13" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D86613;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="rf-1"><mxGeometry x="18" y="1308" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="rf-m23" value="AuditEvent de la tool call (Gateway / Step Functions)" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;strokeColor=#545B64;fontSize=10;fontColor=#545B64;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="rf-1"><mxGeometry relative="1" as="geometry"><mxPoint x="1256" y="1356" as="sourcePoint"/><mxPoint x="1824" y="1356" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="rf-legend" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Círculos naranjas ①–⑬: puntos de control en orden · Flecha continua: llamada · Flecha discontinua: respuesta / evento asíncrono · Nota amarilla: verificación interna del componente&lt;br&gt;Gobernanza preventiva: authN, RBAC L1 y reserva de budget ocurren &lt;b&gt;antes&lt;/b&gt; de invocar modelo o tool; la liquidación y el CUR solo reconcilian.&lt;br&gt;El router vive en mango-api (fuera de AgentCore) y usa Haiku en Bedrock. Filtros RBAC de RAG los construye el backend desde el JWT, nunca el LLM." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeColor=#879196;fillColor=#F8F9FA;fontColor=#232F3E;" vertex="1" parent="rf-1"><mxGeometry x="20" y="1430" width="1860" height="100" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
