  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "readOnlyHint": true
    },
    "description": "Recent events of a CloudFormation stack, newest first: which resource changed, its\nstatus and the reason. Use it to find why a deployment failed or rolled back.\n\nNever the resource properties of an event.\n",
    "inputSchema": {
      "properties": {
        "account_id": {
          "description": "12-digit id of the AWS member account to read. Required: every call reads exactly one account.",
          "pattern": "^[0-9]{12}$",
          "type": "string"
        },
        "hours": {
          "default": 24,
          "description": "How many hours back to look (1-168).",
          "maximum": 168,
          "minimum": 1,
          "title": "Hours",
          "type": "integer"
        },
        "max_items": {
          "default": 50,
          "description": "Most items to return (1-100).",
          "maximum": 100,
          "minimum": 1,
          "title": "Max Items",
          "type": "integer"
        },
        "only_failures": {
          "default": false,
          "description": "Only events whose status is a failure (*_FAILED).",
          "title": "Only Failures",
          "type": "boolean"
        },
        "region": {
          "anyOf": [
            {
              "pattern": "^[a-z]{2}(-[a-z]{1,16}){1,3}-[0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "AWS Region to read. Leave it out to read the installation's Region.",
          "title": "Region"
        },
        "stack": {
          "description": "Stack name, or stack ARN for a deleted stack.",
          "pattern": "^([A-Za-z][A-Za-z0-9-]{0,127}|arn:aws[a-z-]*:cloudformation:[a-z0-9-]+:\\d{12}:stack/[A-Za-z][A-Za-z0-9-]{0,127}/[0-9a-f-]{36})$",
          "title": "Stack",
          "type": "string"
        }
      },
      "required": [
        "account_id",
        "stack"
      ],
      "title": "get_cloudformation_stack_eventsArguments",
      "type": "object"
    },
    "name": "get_cloudformation_stack_events",
    "outputSchema": {
      "additionalProperties": true,
      "title": "get_cloudformation_stack_eventsDictOutput",
      "type": "object"
    }
  },
