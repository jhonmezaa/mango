    "description": "When a resource's configuration changed, as recorded by AWS Config (newest first).\n\nFor each recorded item: capture time, status, related resources and the **names** of the\ntop-level configuration fields that changed since the previous item. Never the values of\nthe configuration, supplementary configuration or tags. Needs AWS Config recording in the\naccount; answers \"what changed on this security group, and when?\".\n",
    "inputSchema": {
      "properties": {
        "account_id": {
          "description": "12-digit id of the AWS member account to read. Required: every call reads exactly one account.",
          "pattern": "^[0-9]{12}$",
          "type": "string"
        },
        "hours": {
          "default": 168,
          "description": "How many hours back to look (1-720).",
          "maximum": 720,
          "minimum": 1,
          "title": "Hours",
          "type": "integer"
        },
        "max_items": {
          "default": 10,
          "description": "Most items to return (1-20).",
          "maximum": 20,
          "minimum": 1,
          "title": "Max Items",
          "type": "integer"
        },
        "region": {
          "anyOf": [
            {
              "pattern": "^[a-z]{2}(-[a-z]{1,16}){1,3}-[0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "AWS Region to read. Leave it out to read the installation's Region.",
          "title": "Region"
