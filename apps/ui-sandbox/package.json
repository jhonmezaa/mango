{
  "name": "@mango/ui-sandbox",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    "./protocol": "./src/protocol.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.app.json --noEmit && vite build && node scripts/build-vendor.mjs",
    "vendor:pyodide": "node scripts/fetch-pyodide-packages.mjs",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "build:e2e": "VITE_SANDBOX_LOOPBACK=true vite build --outDir dist-e2e",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@babel/standalone": "8.1.1",
    "@tailwindcss/browser": "4.3.5",
    "pyodide": "0.26.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "catalog:",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "catalog:",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "catalog:"
  }
}
